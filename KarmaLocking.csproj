<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>KarmaLocking</AssemblyName>
    <RootNamespace>KarmaLocking</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!--
    Reference paths. Override on the command line / via the Makefile, e.g.
      dotnet build -p:RoR2Dir="/path/to/Risk of Rain 2" -p:ProfileDir="/path/to/r2modman/profile"
    The profile's MMHOOK_RoR2.dll must have been regenerated for the current game version
    (launch the game once with that profile), otherwise the Karma hooks won't exist in it.
  -->
  <PropertyGroup>
    <RoR2Dir Condition="'$(RoR2Dir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Risk of Rain 2</RoR2Dir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(HOME)/.config/r2modmanPlus-local/RiskOfRain2/profiles/Hallowed Ready</ProfileDir>
    <ManagedDir>$(RoR2Dir)/Risk of Rain 2_Data/Managed</ManagedDir>
    <BepInExCoreDir>$(ProfileDir)/BepInEx/core</BepInExCoreDir>
    <MMHookDir>$(ProfileDir)/BepInEx/plugins/MMHOOK</MMHookDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools/**;tests/**;bin/**;obj/**;dist/**" />
    <EmbeddedResource Include="assets/lock.png" LogicalName="KarmaLocking.lock.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)/BepInEx.dll" Private="false" />
    <Reference Include="MonoMod.RuntimeDetour" HintPath="$(BepInExCoreDir)/MonoMod.RuntimeDetour.dll" Private="false" />
    <Reference Include="MonoMod.Utils" HintPath="$(BepInExCoreDir)/MonoMod.Utils.dll" Private="false" />
    <Reference Include="MMHOOK_RoR2" HintPath="$(MMHookDir)/MMHOOK_RoR2.dll" Private="false" />
    <Reference Include="RoR2" HintPath="$(ManagedDir)/RoR2.dll" Private="false" />
    <Reference Include="Rewired_Core" HintPath="$(ManagedDir)/Rewired_Core.dll" Private="false" />
    <Reference Include="HGUnityUtils" HintPath="$(ManagedDir)/HGUnityUtils.dll" Private="false" />
    <Reference Include="HGCSharpUtils" HintPath="$(ManagedDir)/HGCSharpUtils.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(ManagedDir)/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Unity.Addressables" HintPath="$(ManagedDir)/Unity.Addressables.dll" Private="false" />
    <Reference Include="Unity.ResourceManager" HintPath="$(ManagedDir)/Unity.ResourceManager.dll" Private="false" />
    <Reference Include="com.unity.multiplayer-hlapi.Runtime" HintPath="$(ManagedDir)/com.unity.multiplayer-hlapi.Runtime.dll" Private="false" />
  </ItemGroup>

</Project>
